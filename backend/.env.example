PORT=8081
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=medicine_inventory

# Telegram daily expiry alerts (keep real credentials only in backend/.env)
TELEGRAM_BOT_TOKEN=replace_with_rotated_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id
EXPIRY_ALERT_HOUR=8
EXPIRY_TIMEZONE=Asia/Phnom_Penh
EXPIRY_TIMEZONE_OFFSET_HOURS=7
EXPIRY_HIGH_VALUE_THRESHOLD=1000
EXPIRY_LARGE_QUANTITY_THRESHOLD=100
